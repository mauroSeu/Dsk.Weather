<Window x:Class="Dsk.Weather.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni — Dsk.Weather"
        Width="512"
        Height="706"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource DynText}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">

    <Window.Resources>
        <!-- Palette Dinamica Material You (aggiornata live da ApplyPalette) -->
        <SolidColorBrush x:Key="DynShellBg" Color="#F2161B26" />
        <SolidColorBrush x:Key="DynPopupBg" Color="#FA171F2E" />
        <SolidColorBrush x:Key="DynCardBg" Color="#8C21293A" />
        <SolidColorBrush x:Key="DynInputBg" Color="#C8111824" />
        <SolidColorBrush x:Key="DynBorder" Color="#AD364259" />
        <SolidColorBrush x:Key="DynAccent" Color="#A8C7FA" />
        <SolidColorBrush x:Key="DynAccentContainer" Color="#D9233654" />
        <SolidColorBrush x:Key="DynOnAccent" Color="#111620" />
        <SolidColorBrush x:Key="DynText" Color="#F1F5F9" />
        <SolidColorBrush x:Key="DynMuted" Color="#A6B4CA" />
        <SolidColorBrush x:Key="DynHoverBg" Color="#9E2A3952" />
        <SolidColorBrush x:Key="DynButtonBg" Color="#BA21293A" />
        <SolidColorBrush x:Key="DynSwitchTrackOff" Color="#88364259" />
        <SolidColorBrush x:Key="DynSwitchThumbOff" Color="#A6B4CA" />
        <SolidColorBrush x:Key="DynDangerBg" Color="#22EF4444" />
        <SolidColorBrush x:Key="DynDangerHoverBg" Color="#38EF4444" />
        <SolidColorBrush x:Key="DynDangerBorder" Color="#55F87171" />
        <SolidColorBrush x:Key="DynDangerFg" Color="#FCA5A5" />

        <DropShadowEffect x:Key="SettingsDropShadow"
                          Color="Black"
                          BlurRadius="26"
                          ShadowDepth="8"
                          Direction="270"
                          Opacity="0.48" />

        <Style x:Key="HeaderCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource DynButtonBg}" />
            <Setter Property="Foreground" Value="{DynamicResource DynText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DynBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource DynAccentContainer}" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource DynAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DynButtonBg}" />
            <Setter Property="Foreground" Value="{DynamicResource DynText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DynBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7.5" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource DynHoverBg}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource DynAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource DynAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource DynOnAccent}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.90" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource DynDangerBg}" />
            <Setter Property="Foreground" Value="{DynamicResource DynDangerFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DynDangerBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource DynDangerHoverBg}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource DynDangerFg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitleStyle">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DynAccent}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="Border" x:Key="SectionCardStyle">
            <Setter Property="Background" Value="{DynamicResource DynCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DynBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="15,13" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="TextBox" x:Key="DarkTextBoxStyle">
            <Setter Property="Background" Value="{DynamicResource DynInputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource DynText}" />
            <Setter Property="CaretBrush" Value="{DynamicResource DynAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DynBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="{DynamicResource DynAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch a Pillola Material You -->
        <Style TargetType="CheckBox" x:Key="MaterialSwitchStyle">
            <Setter Property="Foreground" Value="{DynamicResource DynText}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0" />
                            <Border x:Name="SwitchTrack"
                                    Grid.Column="1"
                                    Width="34"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="{DynamicResource DynSwitchTrackOff}"
                                    BorderBrush="{DynamicResource DynBorder}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="12"
                                         Height="12"
                                         Fill="{DynamicResource DynSwitchThumbOff}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="2,0,0,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource DynAccent}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource DynAccent}" />
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="{DynamicResource DynOnAccent}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource DynAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Custom Material You -->
        <Style TargetType="Slider" x:Key="MaterialSliderStyle">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="20" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2,0,0,2" Background="{DynamicResource DynAccent}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="0,2,2,0" Background="{DynamicResource DynSwitchTrackOff}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ThumbDot"
                                                         Width="14"
                                                         Height="14"
                                                         Fill="{DynamicResource DynAccent}"
                                                         Stroke="{DynamicResource DynShellBg}"
                                                         StrokeThickness="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbDot" Property="Width" Value="16" />
                                                        <Setter TargetName="ThumbDot" Property="Height" Value="16" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem" x:Key="DarkComboItemStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DynText}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Margin="3,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource DynHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource DynAccentContainer}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="DarkComboBoxStyle">
            <Setter Property="Background" Value="{DynamicResource DynInputBg}" />
            <Setter Property="Foreground" Value="{DynamicResource DynText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DynBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{DynamicResource DynInputBg}"
                                                BorderBrush="{DynamicResource DynBorder}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1"
                                                           Text="▾"
                                                           Foreground="{DynamicResource DynMuted}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource DynAccent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="11,7,28,7"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource DynPopupBg}"
                                        BorderBrush="{DynamicResource DynBorder}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Margin="0,4,0,0"
                                        Padding="3"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="200">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem" x:Key="SearchResultItemStyle">
            <Setter Property="Foreground" Value="{DynamicResource DynText}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBg"
                                Background="Transparent"
                                CornerRadius="9"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource DynHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource DynAccentContainer}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar verticale slim stile Material You -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,4,0,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbPill"
                                                        Background="{DynamicResource DynBorder}"
                                                        CornerRadius="3"
                                                        Opacity="0.65" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbPill" Property="Background" Value="{DynamicResource DynAccent}" />
                                                        <Setter TargetName="ThumbPill" Property="Opacity" Value="0.90" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border x:Name="RootShell"
                CornerRadius="26"
                BorderThickness="1"
                Background="{DynamicResource DynShellBg}"
                BorderBrush="{DynamicResource DynBorder}"
                Effect="{StaticResource SettingsDropShadow}">
            <Grid Margin="18,16,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Personalizzato Trascinabile -->
                <Grid Grid.Row="0"
                      Background="Transparent"
                      Cursor="SizeAll"
                      MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                      Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="36"
                            Height="36"
                            CornerRadius="14"
                            Background="{DynamicResource DynAccentContainer}"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource DynAccent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="Impostazioni"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DynText}" />
                        <TextBlock x:Name="HeaderSubtitleText"
                                   Text="Dsk.Weather · Anteprima Live"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource DynMuted}"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            x:Name="BtnHeaderClose"
                            Content="&#xE711;"
                            Style="{StaticResource HeaderCloseButtonStyle}"
                            VerticalAlignment="Center"
                            ToolTip="Chiudi impostazioni (Esc)"
                            Click="BtnClose_Click" />
                </Grid>

                <Border Grid.Row="1"
                        Height="1"
                        Background="{DynamicResource DynBorder}"
                        Opacity="0.45"
                        Margin="0,0,0,12" />

                <!-- Contenuto Scrollabile -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel Orientation="Vertical">

                        <!-- 1. Località Meteo -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="SecLocationsTitle" Text="Località Meteo" Style="{StaticResource SectionTitleStyle}" />

                                <Border Background="{DynamicResource DynInputBg}"
                                        BorderBrush="{DynamicResource DynBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,9"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ActiveLocationCaption"
                                                       Grid.Column="0"
                                                       Text="Località attiva"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DynMuted}" />
                                            <Border x:Name="LocationModeBadge"
                                                    Grid.Column="1"
                                                    CornerRadius="8"
                                                    Padding="7,2"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="LocationModeText"
                                                           Text="Manuale"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="ActiveLocationText"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DynText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <CheckBox x:Name="AutoLocationCheck"
                                          Content="Posizione automatica (rete / IP)"
                                          Style="{StaticResource MaterialSwitchStyle}"
                                          Margin="0,0,0,6"
                                          Checked="AutoLocationCheck_Changed"
                                          Unchecked="AutoLocationCheck_Changed" />

                                <TextBlock x:Name="LocationStatusText"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource DynMuted}"
                                           Margin="2,0,0,8"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />

                                <!-- Lista Posizioni Preferite + Bottone Aggiungi posizione -->
                                <TextBlock x:Name="FavoritesHintText"
                                           Text="Posizioni preferite (1 click per cambiare)"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource DynMuted}"
                                           Margin="2,0,0,6" />

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ItemsControl x:Name="FavoritesList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding PillBg}"
                                                        BorderBrush="{Binding PillBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="10,5"
                                                        Margin="0,0,6,6"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding TooltipText}"
                                                        MouseLeftButtonUp="FavoritePill_Click"
                                                        Tag="{Binding Location}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="6"
                                                                 Height="6"
                                                                 Fill="{DynamicResource DynAccent}"
                                                                 Margin="0,0,6,0"
                                                                 Visibility="{Binding ActiveDotVisibility}" />
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{Binding TextBrush}"
                                                                   FontSize="12.5"
                                                                   FontWeight="{Binding TitleWeight}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Content="✕"
                                                                Tag="{Binding Location}"
                                                                Visibility="{Binding RemoveVisibility}"
                                                                Margin="4,0,0,0"
                                                                Cursor="Hand"
                                                                ToolTip="Rimuovi dai preferiti"
                                                                Click="BtnRemoveFavorite_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent" Padding="4,1,1,1">
                                                                        <TextBlock x:Name="CloseGlyph"
                                                                                   Text="✕"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource DynMuted}"
                                                                                   VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="CloseGlyph" Property="Foreground" Value="#F87171" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button x:Name="BtnAddLocation"
                                            Content="+ Aggiungi posizione"
                                            Style="{StaticResource SettingsAccentButtonStyle}"
                                            Padding="12,5.5"
                                            FontSize="12"
                                            Margin="0,0,0,6"
                                            Click="BtnAddLocation_Click" />
                                </WrapPanel>

                                <!-- Pannello Ricerca Nuova Posizione -->
                                <StackPanel x:Name="AddLocationPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 x:Name="CitySearchBox"
                                                 Style="{StaticResource DarkTextBoxStyle}"
                                                 Margin="0,0,8,0"
                                                 ToolTip="Scrivi il nome della città (es. Serramanna, Milano, Roma)"
                                                 KeyDown="CitySearchBox_KeyDown" />
                                        <Button Grid.Column="1"
                                                x:Name="BtnSearchCity"
                                                Content="Cerca città"
                                                Style="{StaticResource SettingsAccentButtonStyle}"
                                                Click="BtnSearchCity_Click" />
                                    </Grid>

                                    <TextBlock x:Name="SearchStatusText"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource DynMuted}"
                                               Margin="2,6,0,0"
                                               Visibility="Collapsed" />

                                    <ListBox x:Name="CityResultsList"
                                             Background="{DynamicResource DynInputBg}"
                                             BorderBrush="{DynamicResource DynBorder}"
                                             BorderThickness="1"
                                             Margin="0,8,0,0"
                                             MaxHeight="130"
                                             Visibility="Collapsed"
                                             ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                                             SelectionChanged="CityResultsList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Stile & Colori -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="SecStyleTitle" Text="Stile &amp; Colori (Anteprima Live)" Style="{StaticResource SectionTitleStyle}" />

                                <CheckBox x:Name="DefaultStyleCheck"
                                          Content="Usa stile predefinito (consigliato)"
                                          Style="{StaticResource MaterialSwitchStyle}"
                                          Margin="0,0,0,10"
                                          ToolTip="Ripristina i valori predefiniti di Stile e Colori senza toccare le tue città"
                                          Checked="DefaultStyleCheck_Changed"
                                          Unchecked="DefaultStyleCheck_Changed" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LayoutLabel" Grid.Column="0" Text="Layout widget" VerticalAlignment="Center" Foreground="{DynamicResource DynMuted}" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="LayoutCombo"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              SelectionChanged="SettingCombo_Changed">
                                        <ComboBoxItem x:Name="CbiLayoutCard" Content="Card Completa (Riepilogo)" Tag="PixelCard" />
                                        <ComboBoxItem x:Name="CbiLayoutMinimal" Content="Minimal Trasparente" Tag="PixelMinimalTransparent" />
                                        <ComboBoxItem x:Name="CbiLayoutCompact" Content="Material Compatto" Tag="MaterialCompact" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ThemeLabel" Grid.Column="0" Text="Tema colori" VerticalAlignment="Center" Foreground="{DynamicResource DynMuted}" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="ThemeCombo"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              SelectionChanged="SettingCombo_Changed">
                                        <ComboBoxItem x:Name="CbiThemeDynamic" Content="Dinamico dallo sfondo (Material You)" Tag="DynamicWallpaper" />
                                        <ComboBoxItem x:Name="CbiThemeDark" Content="Notte Scura" Tag="PixelDark" />
                                        <ComboBoxItem x:Name="CbiThemeGlass" Content="Vetro Scuro" Tag="GlassDark" />
                                        <ComboBoxItem x:Name="CbiThemeLight" Content="Material Chiaro" Tag="MaterialLight" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ScaleLabel" Grid.Column="0" Text="Dimensione" VerticalAlignment="Center" Foreground="{DynamicResource DynMuted}" />
                                    <Slider Grid.Column="1"
                                            x:Name="ScaleSlider"
                                            Style="{StaticResource MaterialSliderStyle}"
                                            Minimum="0.75"
                                            Maximum="1.50"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            ValueChanged="SettingSlider_Changed" />
                                    <TextBlock Grid.Column="2"
                                               x:Name="ScaleValueText"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{DynamicResource DynAccent}" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OpacityLabel" Grid.Column="0" Text="Opacità card" VerticalAlignment="Center" Foreground="{DynamicResource DynMuted}" />
                                    <Slider Grid.Column="1"
                                            x:Name="OpacitySlider"
                                            Style="{StaticResource MaterialSliderStyle}"
                                            Minimum="0.0"
                                            Maximum="1.0"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            ValueChanged="SettingSlider_Changed" />
                                    <TextBlock Grid.Column="2"
                                               x:Name="OpacityValueText"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{DynamicResource DynAccent}" />
                                </Grid>

                                <CheckBox x:Name="DynamicAtmosphereCheck"
                                          Content="Atmosfera dinamica (sfumatura meteo e ora)"
                                          Style="{StaticResource MaterialSwitchStyle}"
                                          Checked="SettingCheck_Changed"
                                          Unchecked="SettingCheck_Changed" />

                                <CheckBox x:Name="WeatherAnimationsCheck"
                                          Content="Animazioni meteo (sfondo e icona)"
                                          Style="{StaticResource MaterialSwitchStyle}"
                                          Checked="SettingCheck_Changed"
                                          Unchecked="SettingCheck_Changed" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LanguageLabel" Grid.Column="0" Text="Lingua" VerticalAlignment="Center" Foreground="{DynamicResource DynMuted}" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="LanguageCombo"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              SelectionChanged="SettingCombo_Changed">
                                        <ComboBoxItem Content="Italiano" Tag="it" />
                                        <ComboBoxItem Content="English" Tag="en" />
                                        <ComboBoxItem Content="Deutsch" Tag="de" />
                                        <ComboBoxItem Content="Nederlands" Tag="nl" />
                                        <ComboBoxItem Content="Español" Tag="es" />
                                        <ComboBoxItem Content="Português" Tag="pt" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Orologio & Meteo -->
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="SecClockTitle" Text="Orologio &amp; Meteo" Style="{StaticResource SectionTitleStyle}" />

                                <CheckBox x:Name="Use24HourCheck"
                                          Content="Usa formato 24 ore"
                                          Style="{StaticResource MaterialSwitchStyle}"
                                          Checked="SettingCheck_Changed"
                                          Unchecked="SettingCheck_Changed" />
                                <CheckBox x:Name="ShowSecondsCheck"
                                          Content="Mostra i secondi nell'orologio"
                                          Style="{StaticResource MaterialSwitchStyle}"
                                          Checked="SettingCheck_Changed"
                                          Unchecked="SettingCheck_Changed" />
                                <CheckBox x:Name="ShowHourlyCheck"
                                          Content="Mostra striscia 24 ore"
                                          Style="{StaticResource MaterialSwitchStyle}"
                                          Checked="SettingCheck_Changed"
                                          Unchecked="SettingCheck_Changed" />
                                <StackPanel x:Name="HourlyCurvesPanel" Margin="18,0,0,4">
                                    <CheckBox x:Name="ShowHourlyTempCurveCheck"
                                              Content="Curva termica (°)"
                                              Style="{StaticResource MaterialSwitchStyle}"
                                              Checked="SettingCheck_Changed"
                                              Unchecked="SettingCheck_Changed" />
                                    <CheckBox x:Name="ShowHourlyPrecipCurveCheck"
                                              Content="Curva precipitazioni (%)"
                                              Style="{StaticResource MaterialSwitchStyle}"
                                              Checked="SettingCheck_Changed"
                                              Unchecked="SettingCheck_Changed" />
                                    <CheckBox x:Name="ShowHourlyHumidityCurveCheck"
                                              Content="Curva umidità (%)"
                                              Style="{StaticResource MaterialSwitchStyle}"
                                              Checked="SettingCheck_Changed"
                                              Unchecked="SettingCheck_Changed" />
                                </StackPanel>
                                <CheckBox x:Name="EnableWeatherAlertsCheck"
                                          Content="Mostra allerte meteo (bordo giallo/rosso)"
                                          Style="{StaticResource MaterialSwitchStyle}"
                                          Checked="SettingCheck_Changed"
                                          Unchecked="SettingCheck_Changed" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TempUnitLabel" Grid.Column="0" Text="Unità temperatura" VerticalAlignment="Center" Foreground="{DynamicResource DynMuted}" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="UnitCombo"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              SelectionChanged="SettingCombo_Changed">
                                        <ComboBoxItem x:Name="CbiTempC" Content="Celsius (°C)" Tag="Celsius" />
                                        <ComboBoxItem x:Name="CbiTempF" Content="Fahrenheit (°F)" Tag="Fahrenheit" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. Comportamento su Windows 11 -->
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock x:Name="SecWinTitle" Text="Comportamento su Windows 11" Style="{StaticResource SectionTitleStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PinModeLabel" Grid.Column="0" Text="Livello finestra" VerticalAlignment="Center" Foreground="{DynamicResource DynMuted}" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="PinModeCombo"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              SelectionChanged="SettingCombo_Changed">
                                        <ComboBoxItem x:Name="CbiPinDesktop" Content="Fissato sul Desktop" Tag="DesktopPinned" />
                                        <ComboBoxItem x:Name="CbiPinBottom" Content="Sotto le altre finestre" Tag="BottomMost" />
                                        <ComboBoxItem x:Name="CbiPinTop" Content="Sempre in primo piano" Tag="AlwaysOnTop" />
                                    </ComboBox>
                                </Grid>

                                <CheckBox x:Name="LockPositionCheck"
                                          Content="Blocca posizione sullo schermo (impedisci trascinamento)"
                                          Style="{StaticResource MaterialSwitchStyle}"
                                          Checked="SettingCheck_Changed"
                                          Unchecked="SettingCheck_Changed" />

                                <CheckBox x:Name="AutostartCheck"
                                          Content="Avvia automaticamente all'accesso di Windows"
                                          Style="{StaticResource MaterialSwitchStyle}"
                                          Checked="AutostartCheck_Changed"
                                          Unchecked="AutostartCheck_Changed" />

                                <Border Height="1"
                                        Background="{DynamicResource DynBorder}"
                                        Margin="0,12,0,12" />

                                <Button x:Name="BtnExitWidget"
                                        Style="{StaticResource SettingsDangerButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="Termina Dsk.Weather e rimuove il widget dal desktop e dalla barra di sistema"
                                        Click="BtnExitWidget_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7E8;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                                   FontSize="13.5"
                                                   VerticalAlignment="Center"
                                                   Margin="0,1,8,0" />
                                        <TextBlock x:Name="BtnExitWidgetText"
                                                   Text="Chiudi completamente il widget"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
