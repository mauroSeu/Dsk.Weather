<Window x:Class="Dsk.Weather.Windows.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Dsk.Weather.Controls"
        Title="Dsk.Weather"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="WidgetWindow_Loaded"
        Closed="WidgetWindow_Closed"
        MouseLeftButtonDown="WidgetWindow_MouseLeftButtonDown">

    <Window.Resources>
        <DropShadowEffect x:Key="CardDropShadow"
                          Color="Black"
                          BlurRadius="24"
                          ShadowDepth="6"
                          Direction="270"
                          Opacity="0.45" />

        <DropShadowEffect x:Key="MinimalTextShadow"
                          Color="Black"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.72" />

        <Style x:Key="HoverIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#663B82F6" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="#9993C5FD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#991D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootViewport" Margin="20">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="WidgetScaleTransform" ScaleX="1.0" ScaleY="1.0" />
        </Grid.LayoutTransform>

        <Grid.ContextMenu>
            <ContextMenu x:Name="WidgetContextMenu" Opened="WidgetContextMenu_Opened">
                <MenuItem Header="Aggiorna meteo" Click="MenuRefreshWeather_Click" />
                <MenuItem x:Name="MenuToggleDrawerItem" Header="Previsioni 7 giorni" Click="MenuToggleDrawer_Click" />
                <MenuItem Header="Radar precipitazioni live" Click="MenuOpenRadar_Click" />
                <MenuItem x:Name="MenuFavoriteLocations" Header="Cambia località" Visibility="Collapsed" />
                <Separator />
                <MenuItem Header="Stile widget">
                    <MenuItem x:Name="MenuStylePixelCard" Header="Card Completa (Riepilogo)" IsCheckable="True" Click="MenuStylePixelCard_Click" />
                    <MenuItem x:Name="MenuStyleMinimal" Header="Minimal Trasparente" IsCheckable="True" Click="MenuStyleMinimal_Click" />
                    <MenuItem x:Name="MenuStyleCompact" Header="Material Compatto" IsCheckable="True" Click="MenuStyleCompact_Click" />
                </MenuItem>
                <MenuItem Header="Tema colori">
                    <MenuItem x:Name="MenuThemeDynamic" Header="Dinamico dallo sfondo (Material You)" IsCheckable="True" Click="MenuThemeDynamic_Click" />
                    <MenuItem x:Name="MenuThemePixelDark" Header="Notte Scura" IsCheckable="True" Click="MenuThemePixelDark_Click" />
                    <MenuItem x:Name="MenuThemeGlassDark" Header="Vetro Scuro" IsCheckable="True" Click="MenuThemeGlassDark_Click" />
                    <MenuItem x:Name="MenuThemeMaterialLight" Header="Material Chiaro" IsCheckable="True" Click="MenuThemeMaterialLight_Click" />
                </MenuItem>
                <MenuItem Header="Livello finestra">
                    <MenuItem x:Name="MenuPinDesktop" Header="Fissato sul Desktop" IsCheckable="True" Click="MenuPinDesktop_Click" />
                    <MenuItem x:Name="MenuPinBottom" Header="Sotto le altre finestre" IsCheckable="True" Click="MenuPinBottom_Click" />
                    <MenuItem x:Name="MenuPinTop" Header="Sempre in primo piano" IsCheckable="True" Click="MenuPinTop_Click" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="MenuLockPositionItem" Header="Blocca posizione" IsCheckable="True" Click="MenuLockPosition_Click" />
                <MenuItem x:Name="MenuAutostartItem" Header="Avvio automatico con Windows" IsCheckable="True" Click="MenuAutostart_Click" />
                <MenuItem Header="Centra sullo schermo" Click="MenuCenterWidget_Click" />
                <MenuItem Header="Impostazioni..." Click="MenuOpenSettings_Click" />
                <Separator />
                <MenuItem Header="Esci" Click="MenuExit_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <StackPanel Orientation="Vertical" Width="338">
            <!-- Card Principale -->
            <Border x:Name="MainCard"
                    Width="338"
                    CornerRadius="28"
                    BorderThickness="1"
                    Effect="{StaticResource CardDropShadow}"
                    MouseEnter="MainCard_MouseEnter"
                    MouseLeave="MainCard_MouseLeave">
                <Grid x:Name="CardContentHost" SizeChanged="CardContentHost_SizeChanged">
                    <!-- Scena meteo animata stile Samsung One UI sullo sfondo della card -->
                    <controls:WeatherSceneCanvas x:Name="WeatherScene" Panel.ZIndex="0" />

                    <!-- Pulsante rapido discreto on-hover (solo Impostazioni) -->
                    <StackPanel x:Name="HoverActionsBar"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,12,14,0"
                                Panel.ZIndex="10"
                                Opacity="0">
                        <Button x:Name="BtnSettings"
                                Content="&#xE713;"
                                Style="{StaticResource HoverIconButtonStyle}"
                                ToolTip="Impostazioni widget"
                                Click="BtnSettings_Click" />
                    </StackPanel>

                    <!-- LAYOUT 1: Pixel Card (Riepilogo + Orologio + Orario) -->
                    <Grid x:Name="LayoutPixelCard" Width="300" Margin="18,14,18,13" Panel.ZIndex="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Riga At a Glance: Data + Pillola Meteo -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="300">
                            <TextBlock x:Name="CardDateText"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       MaxWidth="172"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <Border x:Name="CardWeatherPill"
                                    CornerRadius="14"
                                    Padding="8,3"
                                    Margin="10,0,0,0"
                                    Cursor="Hand"
                                    RenderTransformOrigin="0.5,0.5"
                                    ToolTip="Clicca per aprire le previsioni a 5 giorni"
                                    MouseEnter="CardWeatherPill_MouseEnter"
                                    MouseLeave="CardWeatherPill_MouseLeave"
                                    MouseLeftButtonUp="WeatherPill_Click">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="WeatherPillScale" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:WeatherIconView x:Name="CardWeatherIcon"
                                                              Width="24"
                                                              Height="24"
                                                              Animate="True"
                                                              Margin="0,0,5,0" />
                                    <TextBlock x:Name="CardPillTempText"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="CardPillRangeText"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="11"
                                               Margin="5,1,0,0"
                                               Typography.NumeralAlignment="Tabular"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Hero Clock + Badge Allerta Meteo (a destra dell'orologio) -->
                        <Grid Grid.Row="1" Margin="0,2,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock x:Name="CardClockText"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="56"
                                           FontWeight="Light"
                                           LineHeight="60"
                                           LineStackingStrategy="BlockLineHeight"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock x:Name="CardSecondsText"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="20"
                                           FontWeight="Light"
                                           Typography.NumeralAlignment="Tabular"
                                           VerticalAlignment="Bottom"
                                           Margin="4,0,0,8"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="CardAmPmText"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom"
                                           Margin="6,0,0,9"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <Border x:Name="CardAlertBadge"
                                    Grid.Column="1"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    MaxWidth="132"
                                    CornerRadius="13"
                                    BorderThickness="1"
                                    Padding="9,5.5"
                                    Margin="6,0,0,0"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="CardAlertBadge_Click">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="CardAlertIcon"
                                                   Text="&#xE7BA;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="10.5"
                                                   Margin="0,0,4,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="CardAlertTitleText"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="9.5"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="CardAlertDetailText"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,1.5,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Avviso At a Glance / Nota Rapida -->
                        <TextBlock Grid.Row="2"
                                   x:Name="CardInsightText"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="312"
                                   Margin="2,1,0,0" />

                        <!-- Contesto Riepilogo -->
                        <TextBlock Grid.Row="3"
                                   x:Name="CardSummaryText"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="312"
                                   Margin="2,1,0,0"
                                   MouseLeftButtonUp="LocationSummary_Click" />

                        <!-- Striscia Previsioni Orarie (24h scorrevole orizzontalmente) -->
                        <Border Grid.Row="4"
                                x:Name="CardHourlyContainer"
                                BorderThickness="0,1,0,0"
                                Margin="0,10,0,0"
                                Padding="0,8,0,0">
                            <Grid Width="300">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollViewer Grid.Row="0"
                                              x:Name="HourlyScrollViewer"
                                              Width="300"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              PanningMode="HorizontalOnly"
                                              Background="Transparent"
                                              PreviewMouseWheel="HourlyScrollViewer_PreviewMouseWheel"
                                              PreviewMouseLeftButtonDown="HourlyScrollViewer_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="HourlyScrollViewer_PreviewMouseMove"
                                              PreviewMouseLeftButtonUp="HourlyScrollViewer_PreviewMouseLeftButtonUp"
                                              LostMouseCapture="HourlyScrollViewer_LostMouseCapture"
                                              ScrollChanged="HourlyScrollViewer_ScrollChanged">
                                    <Grid Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="34" />
                                        </Grid.RowDefinitions>

                                        <ItemsControl Grid.Row="0" x:Name="CardHourlyItems">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="60"
                                                            Background="Transparent"
                                                            Cursor="Hand"
                                                            ToolTip="{Binding TooltipText}">
                                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding HourLabel}"
                                                                       Foreground="{Binding HourBrush}"
                                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                       FontSize="11"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       HorizontalAlignment="Center" />
                                                            <controls:WeatherIconView Width="20"
                                                                                      Height="20"
                                                                                      WeatherCode="{Binding WeatherCode}"
                                                                                      IsDay="{Binding IsDay}"
                                                                                      Margin="0,2,0,1"
                                                                                      HorizontalAlignment="Center" />
                                                            <StackPanel Orientation="Horizontal"
                                                                        Height="12"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding PrecipVisibility}">
                                                                <Path Data="M 4,0 C 4,0 8,4.6 8,7.2 A 4,4 0 1 1 0,7.2 C 0,4.6 4,0 4,0 Z"
                                                                      Width="6.5"
                                                                      Height="8.5"
                                                                      Stretch="Fill"
                                                                      Fill="{Binding PrecipBrush}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,2.5,0" />
                                                                <TextBlock Text="{Binding PrecipLabel}"
                                                                           Foreground="{Binding PrecipBrush}"
                                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                           FontSize="9.5"
                                                                           FontWeight="SemiBold"
                                                                           Typography.NumeralAlignment="Tabular"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Canvas Grid.Row="1"
                                                x:Name="HourlySparklineCanvas"
                                                Height="34"
                                                Margin="0,1,0,0"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </ScrollViewer>

                                <!-- Frecce scorrimento discrete ai lati -->
                                <Button Grid.Row="0"
                                        x:Name="BtnHourlyLeft"
                                        Content="&#xE76B;"
                                        Style="{StaticResource HoverIconButtonStyle}"
                                        Width="20"
                                        Height="20"
                                        FontSize="9.5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="-6,0,0,0"
                                        Panel.ZIndex="5"
                                        Visibility="Collapsed"
                                        ToolTip="Ore precedenti"
                                        Click="BtnHourlyLeft_Click" />

                                <Button Grid.Row="0"
                                        x:Name="BtnHourlyRight"
                                        Content="&#xE76C;"
                                        Style="{StaticResource HoverIconButtonStyle}"
                                        Width="20"
                                        Height="20"
                                        FontSize="9.5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,-6,0"
                                        Panel.ZIndex="5"
                                        Visibility="Collapsed"
                                        ToolTip="Ore successive (24h)"
                                        Click="BtnHourlyRight_Click" />

                                <!-- Indicatore scorrimento Material You -->
                                <Grid Grid.Row="1" Height="2.5" Margin="6,5,6,0">
                                    <Border x:Name="HourlyScrollTrack" CornerRadius="1.25" />
                                    <Border x:Name="HourlyScrollThumb"
                                            CornerRadius="1.25"
                                            HorizontalAlignment="Left"
                                            Width="58" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- LAYOUT 2: Pixel Minimal Trasparente -->
                    <Grid x:Name="LayoutPixelMinimal"
                          Margin="18,14,18,14"
                          Visibility="Collapsed"
                          Effect="{StaticResource MinimalTextShadow}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,58,0">
                            <TextBlock x:Name="MinimalClockText"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="70"
                                       FontWeight="Light"
                                       LineHeight="74"
                                       LineStackingStrategy="BlockLineHeight"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="MinimalSecondsText"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="24"
                                       FontWeight="Light"
                                       Typography.NumeralAlignment="Tabular"
                                       VerticalAlignment="Bottom"
                                       Margin="4,0,0,10"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="MinimalAmPmText"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,12"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,4,0,0">
                            <TextBlock x:Name="MinimalDateText"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="15.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" · "
                                       Foreground="{Binding ElementName=MinimalDateText, Path=Foreground}"
                                       FontSize="15"
                                       VerticalAlignment="Center" />
                            <Border x:Name="MinimalWeatherPill"
                                    Background="Transparent"
                                    CornerRadius="12"
                                    Padding="4,2"
                                    Cursor="Hand"
                                    ToolTip="Clicca per aprire le previsioni a 5 giorni"
                                    MouseLeftButtonUp="WeatherPill_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:WeatherIconView x:Name="MinimalWeatherIcon"
                                                              Width="22"
                                                              Height="22"
                                                              Animate="True"
                                                              Margin="0,0,6,0" />
                                    <TextBlock x:Name="MinimalWeatherText"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="15.5"
                                               FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   x:Name="MinimalSubText"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12.5"
                                   Margin="2,4,0,0"
                                   Opacity="0.88"
                                   MouseLeftButtonUp="LocationSummary_Click" />
                    </Grid>

                    <!-- LAYOUT 3: Material Compatto -->
                    <Grid x:Name="LayoutMaterialCompact" Margin="20,14,44,14" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CompactClockText"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="42"
                                           FontWeight="Light"
                                           LineHeight="44"
                                           LineStackingStrategy="BlockLineHeight"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock x:Name="CompactSecondsText"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="15"
                                           FontWeight="Light"
                                           Typography.NumeralAlignment="Tabular"
                                           VerticalAlignment="Bottom"
                                           Margin="3,0,0,5"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="CompactAmPmText"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom"
                                           Margin="4,0,0,6"
                                           Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="CompactDateText"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="12.5"
                                       FontWeight="Medium"
                                       Margin="2,2,0,0" />
                        </StackPanel>

                        <Border x:Name="CompactDivider"
                                Grid.Column="1"
                                Width="1"
                                Margin="18,4" />

                        <Border x:Name="CompactWeatherPill"
                                Grid.Column="2"
                                CornerRadius="16"
                                Padding="10,6"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                ToolTip="Clicca per aprire le previsioni a 5 giorni"
                                MouseLeftButtonUp="WeatherPill_Click">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:WeatherIconView x:Name="CompactWeatherIcon"
                                                              Width="28"
                                                              Height="28"
                                                              Animate="True"
                                                              Margin="0,0,8,0" />
                                    <TextBlock x:Name="CompactTempText"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="CompactLocationText"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="12"
                                           Margin="2,2,0,0"
                                           MaxWidth="160"
                                           TextTrimming="CharacterEllipsis"
                                           MouseLeftButtonUp="LocationSummary_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Drawer Espandibile Previsioni 5 Giorni & Radar Live (Dimensione Fissa 338px) -->
            <Border x:Name="ForecastDrawer"
                    Width="338"
                    Visibility="Collapsed"
                    Margin="0,6,0,0"
                    CornerRadius="22"
                    BorderThickness="1"
                    Padding="14,11"
                    Effect="{StaticResource CardDropShadow}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DrawerSlideTransform" Y="0" />
                </Border.RenderTransform>
                <StackPanel Orientation="Vertical" Width="308">
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="TabForecastPill"
                                        CornerRadius="11"
                                        Padding="10,4"
                                        Cursor="Hand"
                                        Margin="0,0,6,0"
                                        MouseLeftButtonUp="TabForecast_Click">
                                    <TextBlock x:Name="TabForecastLabel"
                                               Text="Previsioni"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>
                                <Border x:Name="TabRadarPill"
                                        CornerRadius="11"
                                        Padding="10,4"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="TabRadar_Click">
                                    <TextBlock x:Name="TabRadarLabel"
                                               Text="Radar Live"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="DrawerMetaText"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="272"
                                       Margin="2,4,0,0"
                                       MouseLeftButtonUp="LocationSummary_Click" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="&#xE711;"
                                Style="{StaticResource HoverIconButtonStyle}"
                                VerticalAlignment="Top"
                                ToolTip="Chiudi pannello"
                                Click="BtnCloseDrawer_Click" />
                    </Grid>

                    <!-- Area Contenuto Fissa (308x238): Previsioni 7 giorni e Radar hanno la stessa identica forma -->
                    <Grid Width="308" Height="238">
                        <!-- Tab 1: Previsioni 7 giorni + chip dettagli -->
                        <StackPanel x:Name="ForecastTabPanel" Orientation="Vertical" Width="308" Height="238">
                            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,7">
                                <Border x:Name="ChipSunBorder" CornerRadius="9" Padding="6,4.5" Margin="0,0,4,0">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="ChipSunTitle" Text="ALBA / TRAMONTO" FontSize="8.5" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ChipSunText" FontSize="11" FontWeight="SemiBold" Margin="0,1,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ChipUvBorder" CornerRadius="9" Padding="6,4.5" Margin="0,0,4,0">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="ChipUvTitle" Text="INDICE UV" FontSize="8.5" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ChipUvText" FontSize="11" FontWeight="SemiBold" Margin="0,1,0,0" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ChipWindBorder" CornerRadius="9" Padding="6,4.5">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock x:Name="ChipWindTitle" Text="VENTO / UMIDITÀ" FontSize="8.5" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0">
                                            <Path x:Name="ChipWindArrow"
                                                  Data="M 4.5,0 L 8.5,9.5 L 4.5,7.2 L 0.5,9.5 Z"
                                                  Width="7.5"
                                                  Height="8.5"
                                                  Stretch="Fill"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,3.5,0"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="ChipWindArrowRotate" Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <TextBlock x:Name="ChipWindText" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <ItemsControl x:Name="DailyForecastItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3.2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DayLabel}"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular"
                                                   VerticalAlignment="Center" />

                                        <controls:WeatherIconView Grid.Column="1"
                                                                  Width="20"
                                                                  Height="20"
                                                                  WeatherCode="{Binding WeatherCode}"
                                                                  IsDay="True"
                                                                  VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ConditionLabel}"
                                                   Foreground="{Binding MutedBrush}"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="3,0,4,0" />

                                        <!-- Gocciolina + Percentuale Pioggia -->
                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,4,0"
                                                    Visibility="{Binding PrecipVisibility}">
                                            <Path Data="M 4,0 C 4,0 8,4.6 8,7.2 A 4,4 0 1 1 0,7.2 C 0,4.6 4,0 4,0 Z"
                                                  Width="7"
                                                  Height="9.5"
                                                  Stretch="Fill"
                                                  Fill="{Binding AccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,2.5,0" />
                                            <TextBlock Text="{Binding PrecipLabel}"
                                                       Foreground="{Binding AccentBrush}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Typography.NumeralAlignment="Tabular"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Triangolino Direzionale Vento + Velocità -->
                                        <StackPanel Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"
                                                    ToolTip="{Binding WindTooltip}">
                                            <Path Data="M 4.5,0 L 8.5,9.5 L 4.5,7.2 L 0.5,9.5 Z"
                                                  Width="8"
                                                  Height="9"
                                                  Stretch="Fill"
                                                  Fill="{Binding PrimaryTextBrush}"
                                                  Opacity="0.82"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,3,0"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="{Binding WindArrowAngle}" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <TextBlock Text="{Binding WindLabel}"
                                                       Foreground="{Binding MutedBrush}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="11"
                                                       Typography.NumeralAlignment="Tabular"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="5"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MinLabel}"
                                                       Foreground="{Binding MutedBrush}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="12"
                                                       Typography.NumeralAlignment="Tabular"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text=" / "
                                                       Foreground="{Binding MutedBrush}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="11"
                                                       Opacity="0.65"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding MaxLabel}"
                                                       Foreground="{Binding PrimaryTextBrush}"
                                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Typography.NumeralAlignment="Tabular"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Tab 2: Radar Precipitazioni Live -->
                        <StackPanel x:Name="RadarTabPanel" Orientation="Vertical" Width="308" Height="238" Visibility="Collapsed">
                            <controls:WeatherRadarView x:Name="RadarView" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
