<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Dsk.Weather</AssemblyName>
    <RootNamespace>Dsk.Weather</RootNamespace>
    <Version>1.3.5</Version>
    <AssemblyVersion>1.3.5.0</AssemblyVersion>
    <FileVersion>1.3.5.0</FileVersion>
    <Authors>mauroSeu</Authors>
    <Company>Dsk.Weather Open Source</Company>
    <Product>Dsk.Weather</Product>
    <Copyright>Copyright (c) 2026 mauroSeu</Copyright>
    <Description>Widget meteo desktop Material You per Windows 11</Description>
    <Deterministic>true</Deterministic>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dsk.Weather.Tests" />
    <None Include="Avvia-DskWeather.vbs" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
