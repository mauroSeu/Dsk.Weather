<UserControl x:Class="Dsk.Weather.Controls.WeatherRadarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="RadarToolBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Background" Value="#243147" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#3B4C6B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#334563" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1C283B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical" Width="308" Height="238">
        <!-- Viewport Mappa + Overlay Radar + HUD Tattico (308x176) -->
        <Border x:Name="MapFrameBorder"
                Width="308"
                Height="176"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="#334155"
                Background="#0F172A"
                ClipToBounds="True"
                ToolTip="Scorri la rotellina del mouse per cambiare lo zoom (Z5 – Z8)"
                PreviewMouseWheel="MapFrameBorder_PreviewMouseWheel">
            <Grid Width="308" Height="176">
                <Canvas x:Name="BasemapCanvas" Width="308" Height="176" />
                <Canvas x:Name="RadarOverlayCanvas" Width="308" Height="176" Opacity="0.76" />

                <!-- HUD Radar: Mirino, Anello portata in km, Onda Pulse e Pin Città centrato su (154, 88) -->
                <Canvas Width="308" Height="176" IsHitTestVisible="False">
                    <!-- Assi mirino sottili -->
                    <Line x:Name="CrosshairH" X1="92" Y1="88" X2="216" Y2="88" Stroke="#3894A3B8" StrokeThickness="1" StrokeDashArray="2,3" />
                    <Line x:Name="CrosshairV" X1="154" Y1="26" X2="154" Y2="150" Stroke="#3894A3B8" StrokeThickness="1" StrokeDashArray="2,3" />

                    <!-- Anello di portata radar (raggio 56px -> diametro 112px centrato su 154,88) -->
                    <Ellipse x:Name="RadarRangeRing"
                             Canvas.Left="98"
                             Canvas.Top="32"
                             Width="112"
                             Height="112"
                             Stroke="#6638BDF8"
                             StrokeThickness="1"
                             StrokeDashArray="3,3" />

                    <!-- Etichetta portata in km sull'anello -->
                    <Border Canvas.Left="158"
                            Canvas.Top="24"
                            Background="#B80F172A"
                            BorderBrush="#4438BDF8"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4,1">
                        <TextBlock x:Name="RangeRadiusText"
                                   Text="35 km"
                                   Foreground="#93C5FD"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                    </Border>

                    <!-- Bussola Nord in alto a sinistra -->
                    <Border Canvas.Left="8"
                            Canvas.Top="8"
                            Background="#B80F172A"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="5,2">
                        <TextBlock Text="▲ N"
                                   Foreground="#E2E8F0"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="9.5"
                                   FontWeight="SemiBold" />
                    </Border>

                    <!-- Onda Sonar Pulse animata -->
                    <Ellipse x:Name="RadarPulseRing"
                             Canvas.Left="140"
                             Canvas.Top="74"
                             Width="28"
                             Height="28"
                             Stroke="#9938BDF8"
                             StrokeThickness="1.6"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="RadarPulseScale" ScaleX="0.6" ScaleY="0.6" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Pin Città centrale (154, 88) -->
                    <Ellipse Canvas.Left="144" Canvas.Top="78" Width="20" Height="20" Fill="#443B82F6" />
                    <Ellipse Canvas.Left="148.5" Canvas.Top="82.5" Width="11" Height="11" Fill="#FFFFFF" />
                    <Ellipse Canvas.Left="150.5" Canvas.Top="84.5" Width="7" Height="7" Fill="#2563EB" />

                    <!-- Badge Nome Città accanto al pin -->
                    <Border Canvas.Left="165"
                            Canvas.Top="79"
                            Background="#CC0F172A"
                            BorderBrush="#5560A5FA"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="6,1.5">
                        <TextBlock x:Name="CityPinLabel"
                                   Text="Posizione"
                                   Foreground="#F8FAFC"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   MaxWidth="115"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Canvas>

                <!-- Stato caricamento / errore -->
                <Border x:Name="StatusOverlay"
                        Background="#CC0F172A"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="StatusOverlayText"
                               Text="Caricamento radar..."
                               Foreground="#F1F5F9"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="11.5" />
                </Border>
            </Grid>
        </Border>

        <!-- Timeline 8 segmenti (ultime 2h + nowcast) -->
        <UniformGrid x:Name="TimelineBar" Rows="1" Columns="8" Height="4.5" Margin="2,6,2,0">
            <Border x:Name="Seg0" CornerRadius="2" Margin="0,0,2.5,0" Background="#334155" Cursor="Hand" MouseLeftButtonUp="TimelineSegment_Click" Tag="0" />
            <Border x:Name="Seg1" CornerRadius="2" Margin="0,0,2.5,0" Background="#334155" Cursor="Hand" MouseLeftButtonUp="TimelineSegment_Click" Tag="1" />
            <Border x:Name="Seg2" CornerRadius="2" Margin="0,0,2.5,0" Background="#334155" Cursor="Hand" MouseLeftButtonUp="TimelineSegment_Click" Tag="2" />
            <Border x:Name="Seg3" CornerRadius="2" Margin="0,0,2.5,0" Background="#334155" Cursor="Hand" MouseLeftButtonUp="TimelineSegment_Click" Tag="3" />
            <Border x:Name="Seg4" CornerRadius="2" Margin="0,0,2.5,0" Background="#334155" Cursor="Hand" MouseLeftButtonUp="TimelineSegment_Click" Tag="4" />
            <Border x:Name="Seg5" CornerRadius="2" Margin="0,0,2.5,0" Background="#334155" Cursor="Hand" MouseLeftButtonUp="TimelineSegment_Click" Tag="5" />
            <Border x:Name="Seg6" CornerRadius="2" Margin="0,0,2.5,0" Background="#334155" Cursor="Hand" MouseLeftButtonUp="TimelineSegment_Click" Tag="6" />
            <Border x:Name="Seg7" CornerRadius="2" Margin="0" Background="#334155" Cursor="Hand" MouseLeftButtonUp="TimelineSegment_Click" Tag="7" />
        </UniformGrid>

        <!-- Barra Controlli -->
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="BtnPlayPause"
                    Content="&#xE769;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    Style="{StaticResource RadarToolBtnStyle}"
                    ToolTip="Play / Pausa animazione radar"
                    Click="BtnPlayPause_Click" />

            <TextBlock Grid.Column="1"
                       x:Name="TimestampText"
                       Text="In attesa..."
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular"
                       VerticalAlignment="Center"
                       Margin="8,0" />

            <Button Grid.Column="2"
                    x:Name="BtnMapThemeToggle"
                    Content="◐"
                    Style="{StaticResource RadarToolBtnStyle}"
                    Margin="0,0,5,0"
                    ToolTip="Cambia stile mappa (Notturna Scura / Chiara Diurna OpenStreetMap)"
                    Click="BtnMapThemeToggle_Click" />

            <Button Grid.Column="3"
                    x:Name="BtnZoomToggle"
                    Content="Z7"
                    Style="{StaticResource RadarToolBtnStyle}"
                    Margin="0,0,5,0"
                    ToolTip="Cambia livello zoom radar (Z5 Europa · Z6 Regione · Z7 Provincia · Z8 Città)"
                    Click="BtnZoomToggle_Click" />

            <Button Grid.Column="4"
                    x:Name="BtnRefreshRadar"
                    Content="&#xE72C;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    Style="{StaticResource RadarToolBtnStyle}"
                    ToolTip="Aggiorna frame radar"
                    Click="BtnRefreshRadar_Click" />
        </Grid>

        <!-- Barra Graduata Intensità Pioggia (dBZ) + Attribuzione OpenStreetMap -->
        <Grid Margin="2,5,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="46"
                    Height="6"
                    CornerRadius="3"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#38BDF8" Offset="0.0" />
                        <GradientStop Color="#2563EB" Offset="0.33" />
                        <GradientStop Color="#FACC15" Offset="0.66" />
                        <GradientStop Color="#EF4444" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock Grid.Column="1"
                       x:Name="LegendText"
                       Text="Debole · Moderata · Forte"
                       FontSize="9.5"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       x:Name="AttributionText"
                       Text="RainViewer · OSM"
                       FontSize="9.5"
                       Opacity="0.72"
                       VerticalAlignment="Center" />
        </Grid>
    </StackPanel>
</UserControl>
