<UserControl x:Class="Dsk.Weather.Controls.WeatherIconView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Unloaded="WeatherIconView_Unloaded">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="SunBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE082" Offset="0" />
            <GradientStop Color="#FFB300" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MoonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E2ECFF" Offset="0" />
            <GradientStop Color="#9BB8F3" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CloudLightBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#DCE6F5" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CloudDarkBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#DCE5F2" Offset="0" />
            <GradientStop Color="#9AA9C2" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RainDropBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7DD3FC" Offset="0" />
            <GradientStop Color="#38BDF8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LightningBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FDE047" Offset="0" />
            <GradientStop Color="#F59E0B" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas Width="48" Height="48">
            <!-- ClearDay -->
            <Canvas x:Name="LayerClearDay" Width="48" Height="48" Visibility="Visible">
                <Ellipse x:Name="ClearSunHalo" Width="34" Height="34" Canvas.Left="7" Canvas.Top="7" Fill="#33FFB300" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="ClearSunHaloScale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="24" Height="24" Canvas.Left="12" Canvas.Top="12" Fill="{StaticResource SunBrush}" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="ClearSunCoreScale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- ClearNight -->
            <Canvas x:Name="LayerClearNight" Width="48" Height="48" Visibility="Collapsed">
                <Path Data="M29,9 C21.5,9.4 15.5,15.6 15.5,23.2 C15.5,31.1 21.9,37.5 29.8,37.5 C32.6,37.5 35.2,36.7 37.4,35.3 C34.5,39.4 29.7,42 24.3,42 C15.4,42 8.2,34.8 8.2,25.9 C8.2,17.3 15,10.2 23.5,9.8 C25.4,9.7 27.2,9.4 29,9 Z"
                      Fill="{StaticResource MoonBrush}"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="ClearMoonRotate" Angle="0" />
                    </Path.RenderTransform>
                </Path>
                <Ellipse x:Name="ClearStar1" Width="3.5" Height="3.5" Canvas.Left="34" Canvas.Top="11" Fill="#E2ECFF" />
                <Ellipse x:Name="ClearStar2" Width="2.5" Height="2.5" Canvas.Left="39" Canvas.Top="18" Fill="#B8CCF5" />
            </Canvas>

            <!-- PartlyCloudyDay -->
            <Canvas x:Name="LayerPartlyCloudyDay" Width="48" Height="48" Visibility="Collapsed">
                <Ellipse Width="18" Height="18" Canvas.Left="22" Canvas.Top="7" Fill="{StaticResource SunBrush}" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PartlyDaySunScale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Path Data="M13,38 L33,38 C37.4,38 41,34.4 41,30 C41,25.9 37.9,22.5 33.9,22.1 C32.4,17.4 28,14 22.8,14 C16.3,14 11,19.3 11,25.8 C11,26.1 11,26.4 11.1,26.7 C8.2,27.6 6,30.3 6,33.5 C6,36 9.1,38 13,38 Z"
                      Fill="{StaticResource CloudLightBrush}">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="PartlyDayCloudTrans" X="0" />
                    </Path.RenderTransform>
                </Path>
            </Canvas>

            <!-- PartlyCloudyNight -->
            <Canvas x:Name="LayerPartlyCloudyNight" Width="48" Height="48" Visibility="Collapsed">
                <Path Data="M33.5,8 C29.2,8.4 26,12 26,16.4 C26,21 29.7,24.8 34.4,24.8 C36,24.8 37.6,24.3 38.9,23.5 C37.1,26 34.1,27.6 30.8,27.6 C25.5,27.6 21.2,23.3 21.2,18 C21.2,12.9 25.2,8.7 30.3,8.4 Z"
                      Fill="{StaticResource MoonBrush}"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="PartlyNightMoonRotate" Angle="0" />
                    </Path.RenderTransform>
                </Path>
                <Path Data="M13,39 L33,39 C37.4,39 41,35.4 41,31 C41,26.9 37.9,23.5 33.9,23.1 C32.4,18.4 28,15 22.8,15 C16.3,15 11,20.3 11,26.8 C11,27.1 11,27.4 11.1,27.7 C8.2,28.6 6,31.3 6,34.5 C6,37 9.1,39 13,39 Z"
                      Fill="{StaticResource CloudLightBrush}">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="PartlyNightCloudTrans" X="0" />
                    </Path.RenderTransform>
                </Path>
            </Canvas>

            <!-- Cloudy -->
            <Canvas x:Name="LayerCloudy" Width="48" Height="48" Visibility="Collapsed">
                <Path Data="M19,31 L36,31 C39.8,31 43,27.9 43,24 C43,20.4 40.3,17.4 36.8,17 C35.5,12.9 31.7,10 27.2,10 C21.7,10 17.2,14.5 17.2,20 C17.2,20.2 17.2,20.5 17.2,20.7 C14.8,21.5 13,23.8 13,26.5 C13,29 15.7,31 19,31 Z"
                      Fill="{StaticResource CloudDarkBrush}">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="CloudyBackTrans" X="0" />
                    </Path.RenderTransform>
                </Path>
                <Path Data="M12,37 L31,37 C35.4,37 39,33.4 39,29 C39,24.9 35.9,21.5 31.9,21.1 C30.4,16.4 26,13 20.8,13 C14.3,13 9,18.3 9,24.8 C9,25.1 9,25.4 9.1,25.7 C6.2,26.6 4,29.3 4,32.5 C4,35 7.1,37 12,37 Z"
                      Fill="{StaticResource CloudLightBrush}">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="CloudyFrontTrans" X="0" />
                    </Path.RenderTransform>
                </Path>
            </Canvas>

            <!-- Fog -->
            <Canvas x:Name="LayerFog" Width="48" Height="48" Visibility="Collapsed">
                <Path Data="M12,28 L33,28 C36.9,28 40,24.9 40,21 C40,17.4 37.3,14.4 33.8,14 C32.5,9.9 28.7,7 24.2,7 C18.7,7 14.2,11.5 14.2,17 C14.2,17.2 14.2,17.5 14.2,17.7 C11.3,18.5 9,21.2 9,24.3 C9,26.3 10.3,28 12,28 Z"
                      Fill="{StaticResource CloudLightBrush}" />
                <Rectangle Width="28" Height="3.2" RadiusX="1.6" RadiusY="1.6" Canvas.Left="10" Canvas.Top="31.5" Fill="#B8C7DE">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="FogBar1Trans" X="0" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="22" Height="3.2" RadiusX="1.6" RadiusY="1.6" Canvas.Left="13" Canvas.Top="37.5" Fill="#94A7C4">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="FogBar2Trans" X="0" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>

            <!-- Drizzle -->
            <Canvas x:Name="LayerDrizzle" Width="48" Height="48" Visibility="Collapsed">
                <Path Data="M12,30 L33,30 C37,30 40.5,26.6 40.5,22.5 C40.5,18.7 37.7,15.5 34,15.1 C32.6,10.7 28.6,7.5 23.8,7.5 C17.8,7.5 13,12.3 13,18.3 C13,18.6 13,18.9 13.1,19.2 C10.2,20 8,22.6 8,25.7 C8,28.1 9.8,30 12,30 Z"
                      Fill="{StaticResource CloudLightBrush}">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="DrizzleCloudTrans" X="0" />
                    </Path.RenderTransform>
                </Path>
                <Line x:Name="DrizzleDrop1" X1="17" Y1="34" X2="15" Y2="39" Stroke="{StaticResource RainDropBrush}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="DrizzleDrop1Trans" X="0" Y="0" />
                    </Line.RenderTransform>
                </Line>
                <Line x:Name="DrizzleDrop2" X1="25" Y1="34" X2="23" Y2="40" Stroke="{StaticResource RainDropBrush}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="DrizzleDrop2Trans" X="0" Y="0" />
                    </Line.RenderTransform>
                </Line>
                <Line x:Name="DrizzleDrop3" X1="33" Y1="34" X2="31" Y2="39" Stroke="{StaticResource RainDropBrush}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="DrizzleDrop3Trans" X="0" Y="0" />
                    </Line.RenderTransform>
                </Line>
            </Canvas>

            <!-- Rain -->
            <Canvas x:Name="LayerRain" Width="48" Height="48" Visibility="Collapsed">
                <Path Data="M12,29 L33,29 C37,29 40.5,25.6 40.5,21.5 C40.5,17.7 37.7,14.5 34,14.1 C32.6,9.7 28.6,6.5 23.8,6.5 C17.8,6.5 13,11.3 13,17.3 C13,17.6 13,17.9 13.1,18.2 C10.2,19 8,21.6 8,24.7 C8,27.1 9.8,29 12,29 Z"
                      Fill="{StaticResource CloudDarkBrush}">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="RainCloudTrans" X="0" />
                    </Path.RenderTransform>
                </Path>
                <Line x:Name="RainDrop1" X1="15" Y1="33" X2="12" Y2="41" Stroke="{StaticResource RainDropBrush}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="RainDrop1Trans" X="0" Y="0" />
                    </Line.RenderTransform>
                </Line>
                <Line x:Name="RainDrop2" X1="23" Y1="33" X2="20" Y2="42" Stroke="{StaticResource RainDropBrush}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="RainDrop2Trans" X="0" Y="0" />
                    </Line.RenderTransform>
                </Line>
                <Line x:Name="RainDrop3" X1="31" Y1="33" X2="28" Y2="41" Stroke="{StaticResource RainDropBrush}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="RainDrop3Trans" X="0" Y="0" />
                    </Line.RenderTransform>
                </Line>
                <Line x:Name="RainDrop4" X1="37" Y1="32" X2="35" Y2="38" Stroke="{StaticResource RainDropBrush}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="RainDrop4Trans" X="0" Y="0" />
                    </Line.RenderTransform>
                </Line>
            </Canvas>

            <!-- Snow -->
            <Canvas x:Name="LayerSnow" Width="48" Height="48" Visibility="Collapsed">
                <Path Data="M12,29 L33,29 C37,29 40.5,25.6 40.5,21.5 C40.5,17.7 37.7,14.5 34,14.1 C32.6,9.7 28.6,6.5 23.8,6.5 C17.8,6.5 13,11.3 13,17.3 C13,17.6 13,17.9 13.1,18.2 C10.2,19 8,21.6 8,24.7 C8,27.1 9.8,29 12,29 Z"
                      Fill="{StaticResource CloudLightBrush}" />
                <Ellipse x:Name="SnowFlake1" Width="4.5" Height="4.5" Canvas.Left="13" Canvas.Top="33" Fill="#E0F2FE">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SnowFlake1Trans" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="SnowFlake2" Width="4.5" Height="4.5" Canvas.Left="22" Canvas.Top="37" Fill="#FFFFFF">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SnowFlake2Trans" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="SnowFlake3" Width="4.5" Height="4.5" Canvas.Left="31" Canvas.Top="33" Fill="#E0F2FE">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SnowFlake3Trans" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="SnowFlake4" Width="3.5" Height="3.5" Canvas.Left="17" Canvas.Top="40" Fill="#BAE6FD">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SnowFlake4Trans" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="SnowFlake5" Width="3.5" Height="3.5" Canvas.Left="29" Canvas.Top="40" Fill="#BAE6FD">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="SnowFlake5Trans" X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- Thunderstorm -->
            <Canvas x:Name="LayerThunderstorm" Width="48" Height="48" Visibility="Collapsed">
                <Path Data="M12,28 L33,28 C37,28 40.5,24.6 40.5,20.5 C40.5,16.7 37.7,13.5 34,13.1 C32.6,8.7 28.6,5.5 23.8,5.5 C17.8,5.5 13,10.3 13,16.3 C13,16.6 13,16.9 13.1,17.2 C10.2,18 8,20.6 8,23.7 C8,26.1 9.8,28 12,28 Z"
                      Fill="{StaticResource CloudDarkBrush}">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="StormCloudTrans" X="0" />
                    </Path.RenderTransform>
                </Path>
                <Polygon x:Name="StormLightning" Points="25,27 19,36 24,36 21,44 31,33 26,33 29,27" Fill="{StaticResource LightningBrush}" />
                <Line x:Name="StormDrop1" X1="14" Y1="33" X2="12" Y2="39" Stroke="{StaticResource RainDropBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="StormDrop1Trans" X="0" Y="0" />
                    </Line.RenderTransform>
                </Line>
                <Line x:Name="StormDrop2" X1="35" Y1="33" X2="33" Y2="39" Stroke="{StaticResource RainDropBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform>
                        <TranslateTransform x:Name="StormDrop2Trans" X="0" Y="0" />
                    </Line.RenderTransform>
                </Line>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
